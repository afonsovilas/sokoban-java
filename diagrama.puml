@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "com.sokoban" {
    class Application {
        + main()
    }
    class Game {
        - screen : Screen
        - state : State
        + run()
        + setState(state : State)
    }
}

package "com.sokoban.states" {
    abstract class State<T> {
        - model : T
        + step(game: Game, key: KeyStroke)
        + draw(screen: Screen, graphics: TextGraphics)
    }
    class MenuState
    class GameState
}

package "com.sokoban.model" {
    class Menu {
        - entries : List<String>
    }
    class Level {
        - width : int
        - height : int
        - walls : List<Wall>
        - boxes : List<Box>
        - targets : List<Target>
    }
    class LevelLoader
    class ElementCreation
}

package "com.sokoban.model.game.elements" {
    abstract class Element
    class Hero
    class Box
    class Wall
    class Target
}

package "com.sokoban.viewer" {
    class MenuViewer
    class LevelViewer
    interface ElementViewer<T> {
        + draw(element: T, graphics: TextGraphics)
    }
    class HeroViewer
    class BoxViewer
    class WallViewer
    class TargetViewer
}

package "com.sokoban.controller" {
    class HeroController {
        + moveHero(direction: Position)
    }
    class GameRules
}

' --- RELAÇÕES ---

' Main Game Logic
Application ..> Game : creates
Game o-- State : has current

' State Pattern
State <|-- MenuState
State <|-- GameState

' MVC Links
MenuState o-- Menu : model
MenuState o-- MenuViewer : uses

GameState o-- Level : model
GameState o-- LevelViewer : uses

' Viewers
LevelViewer ..> ElementViewer : uses
ElementViewer <|.. HeroViewer
ElementViewer <|.. BoxViewer
ElementViewer <|.. WallViewer
ElementViewer <|.. TargetViewer

' Elements Inheritance (CORRIGIDO AQUI)
Element <|-- Hero
Element <|-- Box
Element <|-- Wall
Element <|-- Target

' Level Composition
Level *-- Element : contains
' (Para ser mais específico, o Level tem listas destes tipos)

' Factory & Loader
LevelLoader ..> ElementCreation : uses
LevelLoader ..> Level : creates

' Controllers
Level --> HeroController : uses
HeroController --> GameRules : uses

@enduml