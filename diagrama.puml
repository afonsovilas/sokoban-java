@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "com.sokoban" {
    class Application {
        + main()
    }
    class Game {
        - screen : Screen
        - state : State
        + run()
        + setState(state : State)
    }
}

package "com.sokoban.states" {
    abstract class State<T> {
        - model : T
        + step(game: Game, key: KeyStroke)
        + draw(screen: Screen, graphics: TextGraphics)
    }
    class MenuState
    class GameState
    class ScoreBoardState
    class WinMenuState
    class GameWonState
}

package "com.sokoban.model" {
    class Menu
    class Level {
        - history : Stack<LevelMemento>
        + undo()
        + saveState()
    }
    class LevelMemento {
        - heroPosition : Position
        - boxPositions : Map<Box, Position>
    }
    class LevelManager
    class LevelLoader
    class MenuFactory
}

package "com.sokoban.model.elements" {
    abstract class Element
    class Hero
    class Box
    class Wall
    class Target
    class Portal
    class PowerUp
}

package "com.sokoban.view" {
    class LevelViewer
    class MenuViewer
    class ScoreBoardViewer
    class WinMenuViewer
    class GameWonViewer
    interface ElementViewer
}

package "com.sokoban.controller" {
    class LevelController {
        + handleInput(key: KeyStroke)
    }
    class HeroController {
        + moveHero(direction: Position)
    }
    class PowerUpManager
    class Collision
    class GameRules

    interface Command {
        + execute(game: Game)
    }
    class LoadLevelCommand
    class OpenLevelMenuCommand

    interface MovementStrategy
}

' --- RELAÇÕES ---

' Core
Application ..> Game : creates
Game o-- State : active state

' State Inheritance
State <|-- MenuState
State <|-- GameState
State <|-- ScoreBoardState
State <|-- WinMenuState
State <|-- GameWonState

' MVC Connections
GameState o-- Level : model
GameState o-- LevelController : controller
GameState o-- LevelViewer : view

MenuState o-- Menu : model
MenuState o-- MenuViewer : view

ScoreBoardState o-- ScoreBoardViewer : view

' Controllers Logic
LevelController --> HeroController : uses
LevelController --> Level : updates
HeroController --> Collision : uses
HeroController --> PowerUpManager : uses
PowerUpManager o-- MovementStrategy : strategy
Menu ..> Command : contains

' Factory & Memento
MenuFactory ..> Menu : creates
Level ..> LevelMemento : creates/restores
LevelLoader ..> Level : creates

' Viewers
LevelViewer ..> ElementViewer : uses

' Elements
Element <|-- Hero
Element <|-- Box
Element <|-- Wall
Element <|-- Target
Element <|-- Portal
Element <|-- PowerUp

Level *-- Element : contains

@enduml