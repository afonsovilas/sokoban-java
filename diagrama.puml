@startuml

' Configuração visual para ficar parecido com diagramas standard
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "App Launcher" {
    class Application {
        + {static} main(args : String[])
    }
}

package "Game Core" {
    class Game {
        - screen : Screen
        - level : Level
        + Game()
        + run() : void
        - processKey(key : KeyStroke) : void
        - draw() : void
    }
}

package "Model" {

    class Position {
        - x : int
        - y : int
        + Position(x: int, y: int)
        + getX() : int
        + getY() : int
        + equals(o : Object) : boolean
    }

    abstract class Element {
        # position : Position
        + Element(x: int, y: int)
        + getPosition() : Position
        + {abstract} draw(graphics : TextGraphics) : void
    }

    class Hero {
        + Hero(x: int, y: int)
        + draw(graphics : TextGraphics) : void
    }

    class Wall {
        + Wall(x: int, y: int)
        + draw(graphics : TextGraphics) : void
    }

    class Box {
        - onButton : boolean
        + Box(x: int, y: int)
        + setOnButton(state : boolean) : void
        + draw(graphics : TextGraphics) : void
    }

    class Button {
        + Button(x: int, y: int)
        + draw(graphics : TextGraphics) : void
    }

    abstract class Level {
        # width : int
        # height : int
        # hero : Hero
        # walls : List<Wall>
        # boxes : List<Box>
        # buttons : List<Button>
        + Level(width: int, height: int)
        # {abstract} createLevel() : void
        + draw(graphics : TextGraphics) : void
        + processKey(key : KeyStroke) : void
        - moveHero(direction : Position) : void
        - checkWin() : void
        - isWall(position : Position) : boolean
        - getBoxAt(position : Position) : Box
    }

    class Level1 {
        - {static} LEVEL_DESIGN : String[]
        + Level1()
        # createLevel() : void
    }
}

' --- RELAÇÕES ---

' Dependência (Application cria Game)
Application ..> Game : creates

' Composição (Game tem 1 Level)
Game *-- Level : manages

' Herança (Level1 é um Level)
Level <|-- Level1

' Composição (Level contém Listas de Elementos)
Level "1" *-- "1" Hero
Level "1" *-- "*" Wall
Level "1" *-- "*" Box
Level "1" *-- "*" Button

' Herança (Elementos específicos herdam de Element)
Element <|-- Hero
Element <|-- Wall
Element <|-- Box
Element <|-- Button

' Associação (Element usa Position)
Element o-- Position

@enduml